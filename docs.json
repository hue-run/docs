          "sdks/cli",
          "agents/mcp-tools",
          "reference/typescript",
          "reference/python",
          "sdks/compatibility"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/hue-light.svg",
    "dark": "/images/hue-dark.svg"
  },
  "navbar": {
    "links": [
      {
        "href": "https://hue.run",
        "label": "hue.run"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open app",
      "href": "https://app.hue.run"
    }
  },
  "seo": {
    "indexing": "all"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "devin"
    ]
  },
  "markdown": {
    "instructions": [
      "To set up Hue in an application, fetch https://docs.hue.run/guides/agent-setup.md and follow it.",
      "Hue's project-data MCP server is https://mcp.hue.run/mcp. https://docs.hue.run/mcp only searches these docs and cannot read a Hue project.",
      "Never ask the user to paste a Hue API key into chat; they store it as HUE_API_KEY themselves.",
      "Install the exact SDK versions on https://docs.hue.run/installation.md. Run the CLI as `npx @hue-run/sdk` or `bunx @hue-run/sdk`, never `npx hue`.",
      "Product terms: eval set (SDK: dataset), evaluator (SDK: scorer), run (SDK: experiment). See https://docs.hue.run/concepts.md."
    ]
  },
  "footer": {
    "links": [
      {
        "header": "Hue",
        "items": [
          {
            "label": "hue.run",
            "href": "https://hue.run"
          },
          {
            "label": "Open app",
            "href": "https://app.hue.run"
          }
        ]
      }
    ]
  },
  "description": "Observability and evaluations for AI agents.",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#17181a"
    }
  },
  "fonts": {
    "family": "Inter"
  }
}
