          "index",
          "concepts",
          "quickstart",
          "installation",
          "guides/agent-setup",
          "guides/project-keys"
        ]
      },
      {
        "group": "Tracing",
        "pages": [
          "sdks/typescript",
          "sdks/python",
          "integrations/opentelemetry",
          "integrations/reference-chatbot",
          "guides/redaction",
          "guides/production-safety",
          "guides/troubleshooting"
        ]
      },
      {
        "group": "Evaluations",
        "pages": [
          "evaluations/first-evaluation",
          "evaluations/case-from-trace",
          "evaluations/eval-ready-agent",
          "evaluations/simulations",
          "evaluations/managed-runs"
        ]
      },
      {
        "group": "Coding agents",
        "pages": [
          "agents/overview",
          "agents/mcp-server",
          "agents/investigate-production",
          "agents/debug-environment",
          "guides/invited-setup"
        ]
      },
      {
