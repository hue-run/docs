    "installSnippets": {
      "oauthServerUrl": "https://mcp.hue.run/mcp",
      "oauthClaudeCodeCli": "claude mcp add --transport http hue https://mcp.hue.run/mcp",
      "oauthCodexCli": "codex mcp add hue --url https://mcp.hue.run/mcp\ncodex mcp login hue",
      "claudeCodeProjectJson": "{\n  \"mcpServers\": {\n    \"hue\": {\n      \"type\": \"http\",\n      \"url\": \"https://mcp.hue.run/mcp\",\n      \"headers\": {\n        \"Authorization\": \"Bearer ${HUE_MCP_KEY}\"\n      }\n    }\n  }\n}",
      "claudeCodeCli": "claude mcp add --transport http --scope user hue https://mcp.hue.run/mcp \\\n  --header 'Authorization: Bearer ${HUE_MCP_KEY}'",
      "cursorJson": "{\n  \"mcpServers\": {\n    \"hue\": {\n      \"url\": \"https://mcp.hue.run/mcp\",\n      \"headers\": {\n        \"Authorization\": \"Bearer ${env:HUE_MCP_KEY}\"\n      }\n    }\n  }\n}",
      "cursorDeeplink": "cursor://anysphere.cursor-deeplink/mcp/install?name=hue&config=eyJ1cmwiOiJodHRwczovL21jcC5odWUucnVuL21jcCIsImhlYWRlcnMiOnsiQXV0aG9yaXphdGlvbiI6IkJlYXJlciAke2VudjpIVUVfTUNQX0tFWX0ifX0=",
      "codexCli": "codex mcp add hue --url https://mcp.hue.run/mcp --bearer-token-env-var HUE_MCP_KEY",
      "codexToml": "[mcp_servers.hue]\nurl = \"https://mcp.hue.run/mcp\"\nbearer_token_env_var = \"HUE_MCP_KEY\"",
      "vscodeJson": "{\n  \"servers\": {\n    \"hue\": {\n      \"type\": \"http\",\n      \"url\": \"https://mcp.hue.run/mcp\",\n      \"headers\": {\n        \"Authorization\": \"Bearer ${input:hue-mcp-key}\"\n      }\n    }\n  },\n  \"inputs\": [\n    {\n      \"type\": \"promptString\",\n      \"id\": \"hue-mcp-key\",\n      \"description\": \"Hue Read or Read and write API key\",\n      \"password\": true\n    }\n  ]\n}",
      "copilotCloudJson": "{\n  \"mcpServers\": {\n    \"hue\": {\n      \"type\": \"http\",\n      \"url\": \"https://mcp.hue.run/mcp?read_only=true\",\n      \"headers\": {\n        \"Authorization\": \"Bearer $COPILOT_MCP_HUE_MCP_KEY\"\n      },\n      \"tools\": [\n        \"get_project_context\",\n        \"search_traces\",\n        \"get_trace\",\n        \"get_span\",\n        \"list_sessions\",\n        \"verify_trace\",\n        \"list_eval_sets\",\n        \"get_eval_set\",\n        \"list_evaluators\",\n        \"get_evaluator\",\n        \"list_runs\",\n        \"get_run\",\n        \"list_cases\",\n        \"get_case\",\n        \"list_environments\",\n        \"get_environment\",\n        \"get_intent_taxonomy\",\n        \"get_intent_summary\",\n        \"list_managed_targets\",\n        \"list_local_agents\",\n        \"list_artifacts\",\n        \"list_api_keys\",\n        \"list_members\",\n        \"search_hue_docs\"\n      ]\n    }\n  }\n}",
      "windsurfJson": "{\n  \"mcpServers\": {\n    \"hue\": {\n      \"serverUrl\": \"https://mcp.hue.run/mcp\",\n      \"headers\": {\n        \"Authorization\": \"Bearer ${env:HUE_MCP_KEY}\"\n      }\n    }\n  }\n}",
      "geminiCli": "gemini mcp add --transport http hue https://mcp.hue.run/mcp -H \"Authorization: Bearer $HUE_MCP_KEY\"",
      "connectPrompt": "Connect me to the Hue MCP server.\n\nIt is a remote MCP server (Streamable HTTP) at https://mcp.hue.run/mcp. Authenticate with a bearer token read from the HUE_MCP_KEY environment variable — reference the variable, do not write the key into a config file.\n\nRegister it under the name \"hue\" using whatever MCP configuration my client uses, then call get_project_context and tell me which Hue project it reached.",
