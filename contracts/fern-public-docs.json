  "endpoints": {
    "application": {
      "production": "https://app.hue.run",
      "staging": "https://staging.hue.run"
    },
    "productMcp": {
      "production": {
        "origin": "https://mcp.hue.run",
        "endpoint": "https://mcp.hue.run/mcp",
        "applicationAlias": "https://app.hue.run/api/mcp"
      },
      "staging": {
        "origin": "https://mcp.staging.hue.run",
        "endpoint": "https://mcp.staging.hue.run/mcp",
        "applicationAlias": "https://staging.hue.run/api/mcp"
      }
    },
    "documentation": {
      "origin": "https://docs.hue.run",
      "mcpEndpoint": "https://docs.hue.run/mcp"
    }
  },
  "serviceKeyPresets": [
    {
      "id": "telemetry_write",
      "name": "Tracing only",
      "capabilities": [
        "telemetry_write"
      ],
      "use": "Send OpenTelemetry traces and verify known trace IDs."
    },
    {
      "id": "project_write",
      "name": "Tracing and evaluations",
      "capabilities": [
        "project_write"
      ],
      "use": "Send traces and manage evaluation, artifact, and simulated-environment workflows."
    },
    {
      "id": "agent_read",
      "name": "Coding agent (read-only)",
      "capabilities": [
        "project_read"
      ],
      "use": "Read project data through Hue's product MCP server."
    },
    {
      "id": "agent_read_write",
      "name": "Coding agent (read + evaluations)",
      "capabilities": [
        "project_read",
        "project_write"
      ],
      "use": "Read project data and author datasets, scorers, experiments and environments through Hue's product MCP server."
    }
  ],
  "packages": {
    "typescript": {
      "name": "@hue-run/sdk",
      "version": "0.2.2"
    },
    "python": {
      "name": "hue-run",
      "version": "0.2.2"
    }
  },
  "mcp": {
    "transport": "Streamable HTTP",
    "authentication": "Bearer project service key",
    "variants": {
      "product": {
        "status": "released",
        "owner": "hue-run/fern",
        "runtime": "dynamic Node.js route in the Fern Vercel application",
        "canonical": {
          "production": "https://mcp.hue.run/mcp",
          "staging": "https://mcp.staging.hue.run/mcp"
        },
        "aliases": {
          "production": "https://app.hue.run/api/mcp",
          "staging": "https://staging.hue.run/api/mcp"
        }
      },
      "documentation": {
        "status": "released",
        "owner": "hue-run/docs",
        "runtime": "Mintlify documentation MCP",
        "endpoint": "https://docs.hue.run/mcp",
        "consumedByProductTool": "search_hue_docs"
      },
      "simulation": {
        "status": "released",
        "owner": "hue-run/fern",
        "runtime": "run-scoped Fern route",
        "route": "/api/v1/simulation-mcp/{runId}"
      },
      "providerFacade": {
        "status": "deployed_inactive",
        "owner": "hue-run/fern",
        "route": "/api/v1/provider-facades/{bindingId}/{grantId}/[[...suffix]]",
        "releaseBoundary": "The route is mounted, but official production provider registrations are empty; Gmail and Slack are not released capabilities."
      }
    },
