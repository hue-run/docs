    "status": "deployed_inactive",
    "owner": "hue-run/fern",
    "runtime": "feature-flagged /api/sim catch-all in the Fern web artifact",
    "hosts": {
      "production": {
        "origin": "https://sim.hue.run",
        "applicationMount": "https://app.hue.run/api/sim"
      },
      "staging": {
        "origin": "https://sim.staging.hue.run",
        "applicationMount": "https://staging.hue.run/api/sim"
      }
    },
    "forms": {
      "production": {
        "path": "https://sim.hue.run/{real-host}/{real-path}",
        "alias": "https://{alias}.sim.hue.run/{real-path}",
        "application": "https://app.hue.run/api/sim/{real-host}/{real-path}"
      },
      "staging": {
        "path": "https://sim.staging.hue.run/{real-host}/{real-path}",
        "alias": "https://{alias}.sim.staging.hue.run/{real-path}",
        "application": "https://staging.hue.run/api/sim/{real-host}/{real-path}"
      }
    },
    "aliasRule": "{alias} is the real host with every dot replaced by a dash, one DNS label",
    "releaseBoundary": "The route is mounted but SIM_GATEWAY_ENABLED is off in every hosted environment and no provider surface is registered. Staging sim hosts are being configured and proven first; production sim hosts are not configured. Customer documentation must not name a mirror host until docs/simulation-hosts.md records it as proven."
  }
