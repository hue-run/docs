      "id": "read",
      "name": "Read",
      "capabilities": [
        "project_read"
      ],
      "use": "Read every project surface through Hue's MCP server, including recorded trace content."
    },
    {
      "id": "read_write",
      "name": "Read and write",
      "capabilities": [
        "project_read",
        "project_write"
      ],
      "use": "Read and write every project surface: MCP tools, tracing, evaluations, artifacts, captures and simulated environments. Billing stays in the app."
    },
    {
      "id": "telemetry_write",
      "name": "Tracing only",
      "capabilities": [
        "telemetry_write"
      ],
      "use": "Send OpenTelemetry traces and verify known trace IDs. Use this key on production application servers."
