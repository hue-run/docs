      "capabilities": [
        "project_read"
      ],
      "use": "Read project data through Hue's product MCP server."
    },
    {
      "id": "agent_read_write",
      "name": "Coding agent (read + evaluations)",
      "capabilities": [
        "project_read",
        "project_write"
      ],
      "use": "Read and write project data through Hue's product MCP server. Billing stays in the app."
