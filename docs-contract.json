    },
    {
      "id": "project_write",
      "name": "Tracing and evaluations",
      "capabilities": [
        "project_write"
      ],
      "use": "Send traces and manage evaluation, artifact, and simulated-environment workflows."
    },
    {
      "id": "capture_write",
      "name": "Source capture only",
      "capabilities": [
        "capture_write"
      ],
      "use": "Record tool evidence and upload source files for captures owned by this key."
